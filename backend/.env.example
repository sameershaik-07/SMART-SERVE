# ==========================================
# SMART-SERVE Backend Environment Configuration
# ==========================================

# Server
PORT=3000
NODE_ENV=production

# Database (PostgreSQL 15+ / 17)
# For production (e.g. Supabase, Neon, RDS), append ?sslmode=require
DATABASE_URL="postgresql://postgres:password123@localhost:5432/servicehub?schema=public"

# CORS & Frontend Origins (comma-separated for multiple, or * for open)
CORS_ORIGIN="http://localhost:5173,https://smartserve.pages.dev,https://yourdomain.com"
FRONTEND_URL="https://smartserve.pages.dev"

# JWT Authentication
JWT_SECRET="replace_with_a_secure_random_64_character_hex_secret_in_production"
JWT_EXPIRE="7d"
REFRESH_TOKEN_EXPIRE="30d"

# Payment Gateway (Razorpay)
# Leave blank or use rzp_test_* for automatic mock/sandbox simulation
RAZORPAY_KEY_ID="rzp_test_dummykey123"
RAZORPAY_KEY_SECRET="dummysecretkey123"

# Transactional Email (Resend)
# Used for signup OTPs and as a fallback for password reset emails.
# Leave blank to log OTPs & reset tokens directly to stdout console in dev/sandbox
RESEND_API_KEY=""

# AWS Cognito (password reset email delivery)
# Create these with infra/cognito/setup.sh. The backend only uses Cognito to
# trigger the forgot-password email; app login remains Postgres + JWT.
AWS_REGION="ap-south-1"
COGNITO_USER_POOL_ID=""
COGNITO_CLIENT_ID=""
COGNITO_RESET_ENABLED="true"
# Use a least-privilege IAM user for the backend, not your admin CLI user.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Cloudinary CDN (Image uploads)
CLOUDINARY_NAME="smartserve_cloud"
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Geolocation Services (Google Maps / Distance Matrix)
# Leave blank for simulated coordinates & dynamic route calculation
GOOGLE_MAPS_API_KEY=""
