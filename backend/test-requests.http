POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "name": "Test Admin",
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}",
  "phone": "+919977665544",
  "role": "ADMIN"
}

# Terminal curl:
# curl -X POST http://localhost:3000/api/auth/register -H "Content-Type: application/json" -d '{"name":"Test Admin","email":"admin_test@example.com","password":"Password123!","phone":"+919977665544","role":"ADMIN"}'


