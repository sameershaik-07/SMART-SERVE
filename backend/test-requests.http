@baseUrl = http://localhost:3000
@customerEmail = customer_test@example.com
@customerPassword = Password123!
@providerEmail = provider_test@example.com
@providerPassword = Password123!
@adminEmail = admin_test@example.com
@adminPassword = Password123!

### 1) Register Customer
# REST Client:
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "name": "Test Customer",
  "email": "{{customerEmail}}",
  "password": "{{customerPassword}}",
  "phone": "+919988776655",
  "role": "CUSTOMER"
}

# Terminal curl:
# curl -X POST http://localhost:3000/api/auth/register -H "Content-Type: application/json" -d '{"name":"Test Customer","email":"customer_test@example.com","password":"Password123!","phone":"+919988776655","role":"CUSTOMER"}'


### 2) Register Provider
# REST Client:
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "name": "Test Provider",
  "email": "{{providerEmail}}",
  "password": "{{providerPassword}}",
  "phone": "+919900112233",
  "role": "PROVIDER",
  "categoryId": 1
}

# Terminal curl:
# curl -X POST http://localhost:3000/api/auth/register -H "Content-Type: application/json" -d '{"name":"Test Provider","email":"provider_test@example.com","password":"Password123!","phone":"+919900112233","role":"PROVIDER","categoryId":1}'


### 3) Register Admin
