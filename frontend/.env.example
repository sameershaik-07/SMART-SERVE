# ==========================================
# SMART-SERVE Frontend Environment Configuration
# ==========================================

# Base API URL:
# - Leave empty ("") if frontend is hosted on the same domain as backend via reverse proxy (/api)
# - Set to full backend URL if hosted separately (e.g. on Cloudflare Pages talking to external backend)
#   Example: VITE_API_URL="https://api.yourdomain.com/api"
VITE_API_URL=""

# WebSocket Server URL:
# - Leave empty ("") if frontend connects through same host reverse proxy
# - Set to backend domain if hosted separately
#   Example: VITE_SOCKET_URL="https://api.yourdomain.com"
VITE_SOCKET_URL=""

